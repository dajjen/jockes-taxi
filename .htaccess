# ============================================================================
# Jockes Taxi — Apache-konfiguration för Oderland (DirectAdmin)
# ============================================================================

Options -Indexes
DirectoryIndex index.html

# ---- Kanonisk URL: tvinga HTTPS + www ----------------------------------------
# Allt pekas mot https://www.jockestaxi.se (samma som canonical i index.html).
# Detta fångar även alternativa domäner som pekas hit (t.ex. jocketaxi.se,
# www.jocketaxi.se) och 301-redirectar dem till den kanoniska adressen —
# så länge domänen serveras från samma dokumentrot (se domänpekare i DirectAdmin).
<IfModule mod_rewrite.c>
  RewriteEngine On
  # Lokal utveckling (Lando/localhost) ska inte skickas till produktion.
  RewriteCond %{HTTP_HOST} !(\.lndo\.site|^localhost|^127\.0\.0\.1)(:[0-9]+)?$ [NC]
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} !^www\.jockestaxi\.se$ [NC]
  RewriteRule ^ https://www.jockestaxi.se%{REQUEST_URI} [R=301,L]
</IfModule>

# ---- Egen 404-sida -----------------------------------------------------------
ErrorDocument 404 /404.html

# ---- Komprimering (snabbare laddning) ----------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript
  AddOutputFilterByType DEFLATE application/json image/svg+xml application/manifest+json
  AddOutputFilterByType DEFLATE text/xml application/xml
</IfModule>

# ---- Cache-headers -----------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  # HTML: kort cache så uppdateringar syns snabbt
  ExpiresByType text/html "access plus 1 hour"
  # Bilder/typsnitt: lång cache (filnamn ändras vid ny version)
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType image/vnd.microsoft.icon "access plus 1 year"
  ExpiresByType application/manifest+json "access plus 1 week"
</IfModule>

# CSS/JS: lång cache. index.html länkar dem med ?v=<datum> — bumpa versionen
# när filerna ändras så att besökare får den nya varianten direkt.
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(png|jpg|jpeg|svg|ico|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# ---- Arbetsfiler som inte ska vara nåbara publikt ----------------------------
<IfModule mod_alias.c>
  RedirectMatch 404 ^/(_[^/]*|Untitled|components/logo/logo\.html|review-lib\.php)$
  # Deploy-skript, dokumentation och projektfiler — ska aldrig serveras, även om
  # de råkar hamna på servern (deployen raderar inte gamla filer).
  RedirectMatch 404 ^/([^/]+\.(sh|md|yml|yaml|lock|log)|package(-lock)?\.json|(docs|test|node_modules)(/.*)?)$
</IfModule>

# ---- Säkerhets-headers -------------------------------------------------------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  # Content-Security-Policy: bara egna filer får laddas och köras. Inga inline-skript
  # (JSON-LD är data och påverkas inte). 'unsafe-inline' gäller enbart stilar, för
  # <style>-blocket i 404.html. Lägger du till en extern tjänst (karta, statistik,
  # typsnitt) måste dess domän läggas till här, annars blockeras den.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
</IfModule>

# ---- Teckenkodning -----------------------------------------------------------
AddDefaultCharset UTF-8
